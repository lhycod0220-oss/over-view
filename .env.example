# mock: 백엔드 없이 내장 목업 데이터로 전체 화면 동작 (기본값)
# http: backend/ 게이트웨이(REST + WebSocket)에 실제로 연결
VITE_DATA_SOURCE=mock

# VITE_DATA_SOURCE=http 일 때만 사용됩니다.
# REST 베이스 URL — Flask 게이트웨이는 0.0.0.0:8080 에 바인딩됩니다 (backend/main.py).
# 라즈베리파이에서 돌릴 때는 localhost 대신 게이트웨이 IP 를 넣으세요.
VITE_API_BASE_URL=http://localhost:8080

# 실시간 텔레메트리 스트림용 WebSocket URL.
# 경로는 /ws/telemetry 로 고정입니다 (backend/app/controllers/websocket_controller.py).
# node_id 쿼리는 백엔드가 무시하므로 붙이지 마세요 — 노드 구분은 프런트에서 client_id 로 합니다.
VITE_WS_URL=ws://localhost:8080/ws/telemetry

# 게이트웨이 timestamp 의 타임존 오프셋.
# 백엔드는 time.strftime("%Y-%m-%dT%H:%M:%S") 로 오프셋 없는 로컬 시각을 보내기 때문에
# (docs/CONTRACT-DIFF.md 4-1절) 프런트가 오프셋을 붙여 해석합니다.
# 게이트웨이(라즈베리파이)의 타임존에 맞추세요. 비워 두면 브라우저 로컬 시간대로 해석합니다.
VITE_GATEWAY_TZ_OFFSET=+09:00

# 목업 스트림의 데이터 생성 주기(ms). http 모드에서는 사용되지 않습니다.
VITE_MOCK_INTERVAL_MS=2000
